{
  "name": "sdr-plantao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "setup": "prisma db push --skip-generate && prisma generate && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "reset": "prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "15.5.26",
    "papaparse": "5.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "2.15.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
